# KRISHVYA Environment Variables Example

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Supabase Cloud Database (PostgreSQL + Realtime WebSockets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Custom Geocoding API Key (Geoapify / LocationIQ)
# If left empty, KRISHVYA automatically uses built-in OpenStreetMap Nominatim with zero API key required!
VITE_GEOCODING_API_KEY=

# Backend API Base URL (leave empty in local development to default to http://localhost:5001/api)
# In production with deployed backend (e.g. Render / Cloud Run), set to your HTTPS backend URL:
# VITE_API_BASE_URL=https://krishvya-api.onrender.com/api
VITE_API_BASE_URL=
