# KRISHVYA Environment Variables Example

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Supabase Cloud Database (PostgreSQL + Realtime WebSockets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Custom Geocoding API Key (Geoapify / LocationIQ)
# If left empty, KRISHVYA automatically uses built-in OpenStreetMap Nominatim with zero API key required!
VITE_GEOCODING_API_KEY=
