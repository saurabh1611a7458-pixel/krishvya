// KRISHVYA Database Schema
// Optimized for Indian smallholder farmers, multi-spectral field monitoring, and agronomist case triage
// Uses SQLite for zero-config persistence, easily migratable to PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  phone             String   @unique
  email             String?  @unique
  passwordHash      String?
  role              String   @default("FARMER") // FARMER, EXPERT, ADMIN
  preferredLanguage String   @default("ENGLISH") // BHOJPURI, ENGLISH, HINDI, KANNADA, MARATHI, TAMIL, TELUGU
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  farmerProfile FarmerProfile?
  farms         Farm[]
  problemCases  ProblemCase[]
  expertReviews ExpertReview[]
}

model FarmerProfile {
  id                    String  @id @default(uuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  village               String?
  district              String
  state                 String
  pincode               String?
  totalLandAcres        Float   @default(0.0)
  experienceYears       Int?
  voiceAssistantEnabled Boolean @default(true)
  smsNotifications      Boolean @default(true)
}

model Farm {
  id              String   @id @default(uuid())
  name            String
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address         String
  district        String
  state           String
  latitude        Float
  longitude       Float
  size            Float
  sizeUnit        String   @default("acres")
  farmHealthScore Int      @default(84)
  irrigationType  String   @default("Drip")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  crop         Crop?
  soil         SoilData?
  weather      WeatherData?
  satellite    SatelliteData?
  problemCases ProblemCase[]
}

model Crop {
  id                  String    @id @default(uuid())
  farmId              String    @unique
  farm                Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name                String
  variety             String?
  stage               String    @default("FLOWERING") // SEEDLING, VEGETATIVE, FLOWERING, FRUITING, HARVEST
  sowingDate          DateTime
  expectedHarvestDate DateTime?
}

model SoilData {
  id                 String    @id @default(uuid())
  farmId             String    @unique
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthScore        Int       @default(78)
  nitrogen           String    @default("Good")
  phosphorus         String    @default("Medium")
  potassium          String    @default("Good")
  ph                 Float     @default(6.7)
  organicCarbon      String    @default("Medium (0.6%)")
  moisturePercentage Float     @default(42.0)
  soilType           String    @default("Loamy Black Cotton")
  lastTestedDate     DateTime?
}

model WeatherData {
  id              String   @id @default(uuid())
  farmId          String   @unique
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  temperature     Float    @default(28.0)
  condition       String   @default("Partly Cloudy")
  rainProbability Float    @default(60.0)
  humidity        Float    @default(72.0)
  windSpeedKmh    Float    @default(12.0)
  advice          String
  updatedAt       DateTime @default(now())
}

model SatelliteData {
  id                    String   @id @default(uuid())
  farmId                String   @unique
  farm                  Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthScore           Int      @default(82)
  ndvi                  Float    @default(0.78)
  lastUpdated           DateTime @default(now())
  stressDetected        Boolean  @default(false)
  stressAreaDescription String?
}

model ProblemCase {
  id               String    @id @default(uuid())
  farmerId         String
  farmer           User      @relation(fields: [farmerId], references: [id])
  farmId           String
  farm             Farm      @relation(fields: [farmId], references: [id])
  category         String
  title            String
  description      String
  status           String    @default("SUBMITTED") // SUBMITTED, AI_ANALYZING, EXPERT_REVIEW, RESOLVED
  confidenceScore  Float?
  aiRecommendation String?
  expertNotes      String?
  assignedExpertId String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  expertReviews ExpertReview[]
}

model ExpertReview {
  id          String      @id @default(uuid())
  caseId      String
  problemCase ProblemCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  expertId    String
  expert      User        @relation(fields: [expertId], references: [id])
  notes       String
  approved    Boolean     @default(true)
  timestamp   DateTime    @default(now())
}

model Alert {
  id             String   @id @default(uuid())
  district       String
  category       String
  title          String
  description    String
  severity       String
  actionableText String?
  createdAt      DateTime @default(now())
}
